{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snap Vision",
  "version": "0.1.0",
  "identifier": "com.snapvision.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "chat",
        "url": "chat.html",
        "title": "Snap Vision",
        "width": 560,
        "height": 520,
        "minWidth": 400,
        "minHeight": 380,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
