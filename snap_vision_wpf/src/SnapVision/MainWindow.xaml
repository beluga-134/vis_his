<Window x:Class="SnapVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snap Vision · 截图问答"
        Icon="app.ico"
        Width="560" Height="520" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="True"
        ResizeMode="CanResize"
        WindowChrome.IsHitTestVisibleInChrome="False">
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：不用 WindowChrome 的非客户区命中测试（与 AllowsTransparency
             组合不可靠，曾导致标题栏按钮不可点）。拖拽改 DragMove，缩放仍用 ResizeBorder -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 圆角 8：与 Win11 DWMWCP_ROUND 系统圆角一致（代码里同步设置），
         消除系统方形边框在四角的残留；面板 12 保持梯度 -->
    <Border x:Name="RootBorder" CornerRadius="8"
            BorderBrush="#2EFFFFFF" BorderThickness="1"
            Background="Transparent">
        <Grid MouseDown="OnRootMouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitlebarDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Snap Vision · 截图问答" FontSize="13"
                               Foreground="#C9D6EA" Margin="14,0,6,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                        <Button x:Name="BtnSettings" Content="⚙" ToolTip="设置" Width="30" Height="26"
                                Margin="2,0" Style="{StaticResource TitleBtn}" Click="OnToggleSettings" />
                        <Button x:Name="BtnDb" Content="🗄" ToolTip="数据库挂载（“数据库问答”引擎数据源）" Width="30" Height="26"
                                Margin="2,0" Style="{StaticResource TitleBtn}" Click="OnToggleDb" />
                        <Button x:Name="BtnClear" Content="🧹" ToolTip="清空当前对话（旧会话仍保留在 his_vis-*.jsonl）" Width="30" Height="26"
                                Margin="2,0" Foreground="#FFD66E" Style="{StaticResource TitleBtn}" Click="OnClearChat" />
                        <Button x:Name="BtnHide" Content="—" ToolTip="隐藏窗口（Alt+右键截图时会自动弹出）" Width="30" Height="26"
                                Margin="2,0" Style="{StaticResource TitleBtn}" Click="OnHide" />
                        <Button x:Name="BtnClose" Content="✕" ToolTip="退出" Width="30" Height="26"
                                Margin="2,0" Foreground="White" Style="{StaticResource TitleBtnClose}" Click="OnClose" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 聊天区 -->
            <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                          ScrollChanged="OnChatScrollChanged" Padding="14,14,14,8">
                <StackPanel x:Name="ChatPanel" />
            </ScrollViewer>

            <!-- 状态条 -->
            <Border Grid.Row="2" Padding="16,4,16,4">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6B7686" Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#A9B7CC"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                </StackPanel>
            </Border>

            <!-- 输入区 -->
            <Border Grid.Row="3" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="12,10,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ComposerBox" Grid.Column="0"
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="96"
                             FontSize="13.5" Foreground="#E8EEF8" CaretBrush="#E8EEF8"
                             Background="#40000000" BorderBrush="#2EFFFFFF" BorderThickness="1"
                             Padding="10,8,10,8" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="OnComposerKey" TextChanged="OnComposerTextChanged" />
                    <TextBlock x:Name="ComposerHint" Grid.Column="0" IsHitTestVisible="False"
                               Text="继续追问…（Enter 发送，Shift+Enter 换行）" FontSize="13"
                               Foreground="#7F8DA2" Margin="12,9,12,0" VerticalAlignment="Top" />
                    <Button x:Name="BtnSend" Grid.Column="1" Content="发送" Margin="8,0,0,1"
                            Padding="18,0,18,0" Height="36" VerticalAlignment="Bottom"
                            Background="#594D84FE" BorderBrush="#7378AAFF" Foreground="#EAF1FF"
                            FontSize="13" Cursor="Hand" Click="OnSend" />
                </Grid>
            </Border>

            <!-- 浮层：设置/数据库面板 -->
            <Grid Grid.Row="0" Grid.RowSpan="4" x:Name="OverlayHost" />
        </Grid>
    </Border>
</Window>
